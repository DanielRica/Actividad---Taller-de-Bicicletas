<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580" prefWidth="800" styleClass="main-content" stylesheets="@Styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.taller.Controllers.ClientController">

<children>

        <Label styleClass="header-title" text="Lista de Clientes" AnchorPane.leftAnchor="5.0" />
    <VBox spacing="25.0" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <HBox>

            <VBox prefWidth="300" styleClass="form">

                <Label styleClass="form-label" text="Nombres y Apellidos:" />
                <TextField fx:id="txtName" promptText="Escriba los nombres y apellidos de la persona" styleClass="text-area" />

                <Label styleClass="form-label" text="ID:" />
                <TextField fx:id="txtId" promptText="Escriba la cedula de la persona" styleClass="text-area" />

                <Label styleClass="form-label" text="Teléfono:" />
                <TextField fx:id="txtPhone" promptText="Escriba el telefono de la persona" styleClass="text-area" />
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0">
               <children>
   
                   <Label styleClass="form-label" text="Direccion:" />
                   <TextField fx:id="txtAddress" promptText="Escriba la direccion de la persona" styleClass="text-area" />
               </children>
            </VBox>
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>

        </HBox>
         <HBox>
            <children>
                <Button onAction="#OnDelete" styleClass="danger-btn" text="Eliminar">
                  <HBox.margin>
                     <Insets right="5.0" />
                  </HBox.margin>
               </Button>
                <Button onAction="#OnEdit" styleClass="modify-btn" text="Modificar">
                  <HBox.margin>
                     <Insets right="5.0" />
                  </HBox.margin>
               </Button>
                <Button onAction="#OnSave" styleClass="save-btn" text="Guardar" />
            </children>
         </HBox>

              <TableView fx:id="tblClients" prefHeight="300" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId" prefWidth="169.60000228881836" text="ID" />
                <TableColumn fx:id="colName" prefWidth="284.0000457763672" text="Nombres" />
                <TableColumn fx:id="colPhone" minWidth="3.20001220703125" prefWidth="234.39996337890625" text="Teléfono" />
                <TableColumn fx:id="colAddress" prefWidth="260.7999633789062" text="Direccion" />
            </columns>
        </TableView>

    </VBox>
</children>

</AnchorPane>
