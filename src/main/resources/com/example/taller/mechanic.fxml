<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580" prefWidth="800" styleClass="background-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.taller.Controllers.MechanicController">

<children>
    <VBox spacing="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

        <Label styleClass="title-label" text="Lista de Mecánicos" />

        <HBox spacing="30">

            <VBox prefWidth="300" spacing="10">

                <Label styleClass="form-label" text="Nombres y Apellidos:" />
                <TextField fx:id="txtName" promptText="Escriba el nombre completo" styleClass="text-field" />

                <Label styleClass="form-label" text="Especiallidad:" />
               <ComboBox fx:id="cbSpeciality" prefWidth="150.0" promptText="Escoja la especialidad" />

                <Label styleClass="form-label" text="Número de Certificación:" />
                <TextField fx:id="txtcNumber" promptText="Escriba el número de certificación" styleClass="text-field" />
            </VBox>

            <VBox alignment="TOP_CENTER" prefWidth="150" spacing="15">
                <Button onAction="#OnSave" styleClass="primary-btn" text="💾 Guardar" />
                <Button onAction="#OnEdit" styleClass="secondary-btn" text="✏ Modificar" />
                <Button onAction="#OnDelete" styleClass="danger-btn" text="🗑 Eliminar" />
            </VBox>

        </HBox>

        <TableView fx:id="tblMechanics" prefHeight="300" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colName" prefWidth="180" text="Nombre" />
                <TableColumn fx:id="colSpeciality" prefWidth="92.79998779296875" text="Especialidad" />
                <TableColumn fx:id="colcNumber" prefWidth="148.79998779296875" text="Número de Certificación" />
            </columns>
        </TableView>

    </VBox>
</children>

</AnchorPane>
