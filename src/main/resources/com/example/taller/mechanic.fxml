<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580" prefWidth="800" styleClass="main-content" stylesheets="@Styles/styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.taller.Controllers.MechanicController">

<children>

     <Label styleClass="header-title" text="Lista de Mecánicos" AnchorPane.leftAnchor="5.0" />
    <VBox spacing="20" AnchorPane.bottomAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.topAnchor="20">

        <HBox>
   
            <VBox prefWidth="300" styleClass="form">
   
                <Label styleClass="form-label" text="Nombres y Apellidos:" />
                <TextField fx:id="txtName" promptText="Escriba el nombre completo" styleClass="text-area" />
   
                <Label styleClass="form-label" text="Especiallidad:" />
               <ComboBox fx:id="cbSpeciality" prefWidth="150.0" promptText="Escoja la especialidad" styleClass="text-area" />
   
                <Label styleClass="form-label" text="Número de Certificación:" />
                <TextField fx:id="txtcNumber" promptText="Escriba el número de certificación" styleClass="text-area" />
            </VBox>
            <VBox.margin>
               <Insets top="50.0" />
            </VBox.margin>

        </HBox>
         <HBox>
            <children>
                <Button onAction="#OnDelete" styleClass="danger-btn" text="Eliminar" />
                <Button onAction="#OnEdit" styleClass="modify-btn" text="Modificar" />
                <Button onAction="#OnSave" styleClass="save-btn" text="Guardar" />
            </children>
         </HBox>

        <TableView fx:id="tblMechanics" prefHeight="300" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colName" prefWidth="388.8000602722168" text="Nombre" />
                <TableColumn fx:id="colSpeciality" prefWidth="164.79998779296875" text="Especialidad" />
                <TableColumn fx:id="colcNumber" prefWidth="399.199951171875" text="Número de Certificación" />
            </columns>
        </TableView>

    </VBox>
</children>

</AnchorPane>
