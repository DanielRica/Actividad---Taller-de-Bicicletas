<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="580" prefWidth="800" styleClass="background-pane" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.taller.Controllers.ServiceOrderController">

<children>
    <VBox spacing="20" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0">

        <Label styleClass="title-label" text="Crear Orden de Servicio" />

        <!-- FORMULARIO -->
        <HBox spacing="30">
   
            <VBox prefWidth="300" spacing="10">
                <Label styleClass="form-label" text="Fecha de ingreso" />
               <DatePicker fx:id="datePicker" />
   
                <Label styleClass="form-label" text="Hora:" />
               <AnchorPane prefHeight="200.0" prefWidth="200.0">
                  <children>
                     <Spinner fx:id="hourSp" layoutX="14.0" layoutY="1.0" prefHeight="26.0" prefWidth="106.0" />
                     <Spinner fx:id="minuteSp" layoutX="155.0" layoutY="1.0" prefHeight="26.0" prefWidth="106.0" />
                  </children>
               </AnchorPane>
   
                <Label styleClass="form-label" text="Bicicleta:" />
               <ComboBox fx:id="cbNumber" prefWidth="150.0" promptText="Número Serial" />
               <Label styleClass="form-label" text="Mecánico Asignado:" />
               <ComboBox fx:id="cbMechanic" prefWidth="150.0" promptText="Mecánico Asignado" />
   
                <Label styleClass="form-label" text="Motivo del Servicio" />
                <TextField fx:id="txtServiceMotive" promptText="Escriba el motivo del servicio" styleClass="text-field" />
   
                <Label styleClass="form-label" text="Diagnóstico:" />
                <TextField fx:id="txtDiagnosis" promptText="Escriba el diagnóstico de la bicicleta" styleClass="text-field" />
            </VBox>

            <!-- BOTONES -->
            <VBox alignment="TOP_CENTER" prefWidth="150" spacing="15">
               <children>
                  <Label styleClass="form-label" text="Trabajos Realizados:" />
                  <TextField fx:id="txtWorkDone" promptText="Escriba el trabajo realizado" styleClass="text-field" />
                  <Label styleClass="form-label" text="Coste Total:" />
                  <TextField fx:id="txtPrice" promptText="Escriba el coste total" styleClass="text-field" />
                  <Label styleClass="form-label" text="Filtrar por día:" />
                  <DatePicker fx:id="dateFilter" />
                  <AnchorPane prefHeight="22.0" prefWidth="142.0">
                     <children>
                        <Button layoutY="1.0" onAction="#OnFilter" styleClass="primary-btn" text="📅 Filtrar" />
                        <Button layoutX="71.0" layoutY="1.0" onAction="#OnEraseFilter" styleClass="primary-btn" text="📅 Borrar" />
                     </children>
                  </AnchorPane>
                  <Label styleClass="form-label" text="Filtrar por Serial:" />
                  <ComboBox fx:id="cbNumber1" prefWidth="150.0" promptText="Número Serial" />
                  <AnchorPane prefHeight="22.0" prefWidth="142.0">
                     <children>
                        <Button layoutY="1.0" onAction="#OnFilter2" styleClass="primary-btn" text="📅 Filtrar" />
                        <Button layoutX="71.0" layoutY="1.0" onAction="#OnEraseFilter2" styleClass="primary-btn" text="📅 Borrar" />
                     </children>
                  </AnchorPane>
               </children>
            </VBox>
             <Button onAction="#OnSave" styleClass="primary-btn" text="💾 Guardar" />
             <Button onAction="#OnEdit" styleClass="secondary-btn" text="✏ Modificar" />
             <Button onAction="#OnDelete" styleClass="danger-btn" text="🗑 Eliminar" />

        </HBox>

           <!-- TABLA -->
        <TableView fx:id="tblDiagnosis" prefHeight="300" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colDate" prefWidth="76.0" text="Fecha de Ingreso" />
                <TableColumn fx:id="colHour" prefWidth="52.800048828125" text="Hora" />
                <TableColumn fx:id="colBike" prefWidth="78.39996337890625" text="Bicicleta" />
                <TableColumn fx:id="colMechanic" prefWidth="144.0" text="Mecánico" />
                <TableColumn fx:id="colMotive" prefWidth="120.0" text="Motivo del Servicio" />
               <TableColumn fx:id="colDiagnosis" prefWidth="100.79998779296875" text="Diagnóstico" />
               <TableColumn fx:id="colWorkDone" prefWidth="98.4000244140625" text="Trabajos Realizados" />
               <TableColumn fx:id="colPrice" prefWidth="87.199951171875" text="Precio Total" />
            </columns>
        </TableView>

    </VBox>
</children>

</AnchorPane>
